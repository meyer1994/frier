{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frier",
  "main": "./server/index.mjs",
  "compatibility_date": "2026-01-09",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 10
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
